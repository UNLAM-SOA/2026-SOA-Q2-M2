<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_monitoreo"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/modo_simulado"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/conexionTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="MQTT: desconectado"
            android:textSize="16sp" />

        <Button
            android:id="@+id/conectarBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conectar MQTT" />

        <Button
            android:id="@+id/desconectarBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Desconectar MQTT" />

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/estado_simulado"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvSaldo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/saldo_simulado"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvCorriente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/corriente_simulada"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvTemperatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/temperatura_simulada"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/recargaInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:hint="Cantidad a recargar (Wh)"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <Button
            android:id="@+id/recargarBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Recargar" />

        <Button
            android:id="@+id/autorizarBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Autorizar uso" />

        <Button
            android:id="@+id/finalizarBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="Finalizar uso" />

        <!-- TODO: Quitar estos controles; se usan solo para probar consumo y saldo agotado. -->
        <EditText
            android:id="@+id/consumoInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:hint="Consumo simulado (Wh)"
            android:inputType="numberDecimal"
            android:enabled="false"
            android:maxLines="1" />

        <Button
            android:id="@+id/simularConsumoBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="Simular consumo" />

        <!-- TODO: Quitar el campo y botón de temperatura cuando se use el sensor del ESP32. -->
        <EditText
            android:id="@+id/temperaturaInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:hint="Temperatura simulada (°C)"
            android:inputType="numberDecimal|numberSigned"
            android:maxLines="1" />

        <Button
            android:id="@+id/aplicarTemperaturaBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Aplicar temperatura" />

        <Button
            android:id="@+id/habilitarBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="Habilitar equipo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/aclaracion_simulacion"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
